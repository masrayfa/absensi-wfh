# Copy this file to `.env` before running anything:
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
# Every backend script loads it via `dotenv -e ../../.env`; without it the
# services boot but Prisma fails with "Environment variable not found:
# DATABASE_URL" (see README → Troubleshooting).

# ---- Database -------------------------------------------------------------
# Root password for the MySQL container; also read by docker-compose.yml.
MYSQL_ROOT_PASSWORD=root
# Prisma connection URL for auth-service (its own schema: auth_db).
DATABASE_URL_AUTH=mysql://root:root@localhost:3306/auth_db
# Prisma connection URL for employee-service (its own schema: employee_db).
DATABASE_URL_EMPLOYEE=mysql://root:root@localhost:3306/employee_db
# Prisma connection URL for attendance-service (its own schema: attendance_db).
DATABASE_URL_ATTENDANCE=mysql://root:root@localhost:3306/attendance_db

# ---- Auth / JWT -----------------------------------------------------------
# Secret used to sign and verify JWTs (auth-service signs, gateway verifies). Change in production.
JWT_SECRET=change-me-in-production-please-use-a-long-random-string

# ---- Service ports (TCP microservices) ------------------------------------
# TCP port the auth-service microservice listens on.
AUTH_TCP_PORT=4001
# TCP port the employee-service microservice listens on.
EMPLOYEE_TCP_PORT=4002
# TCP port the attendance-service microservice listens on.
ATTENDANCE_TCP_PORT=4003
# Hosts the gateway dials for each TCP service. Default 127.0.0.1 (native dev);
# docker-compose.yml overrides them with the compose service names, so they are
# normally left unset here.
# AUTH_TCP_HOST=127.0.0.1
# EMPLOYEE_TCP_HOST=127.0.0.1
# ATTENDANCE_TCP_HOST=127.0.0.1

# ---- Gateway --------------------------------------------------------------
# HTTP port the api-gateway listens on (Swagger at /docs).
GATEWAY_PORT=3000
# Allowed browser origin for CORS (the React web app).
WEB_ORIGIN=http://localhost:5173

# ---- Uploads --------------------------------------------------------------
# Directory where uploaded attendance photos are stored and served from at /uploads.
UPLOAD_DIR=./uploads
