{
  "name": "@app/auth-service",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "dotenv -e ../../.env -- ts-node --transpile-only -P tsconfig.json src/main.ts",
    "typecheck": "prisma generate --schema prisma/schema.prisma && tsc -p tsconfig.json --noEmit",
    "test": "node ../../tools/backend-test.cjs --provision auth",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate deploy --schema prisma/schema.prisma",
    "seed": "prisma generate --schema prisma/schema.prisma && dotenv -e ../../.env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@app/common": "workspace:*",
    "@app/contracts": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/microservices": "^12.1.2",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.5.2",
    "prisma": "6.19.3",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15"
  }
}
