{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "baseUrl": "../../../",
    "paths": {
      "@app/contracts": ["libs/contracts/dist/index.d.ts"],
      "@app/common": ["libs/common/dist/index.d.ts"]
    }
  },
  "include": ["./**/*.ts"]
}
