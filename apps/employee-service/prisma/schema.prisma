// employee-service owns employee_db. email is the identity join key to auth_db
// (no cross-database foreign key — the services are separate schemas).
generator client {
  provider = "prisma-client-js"
  // App-local output: pnpm dedupes @prisma/client to one store path, so the
  // default output would let the three services clobber each other's client.
  output   = "../generated/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_EMPLOYEE")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

model Employee {
  id         String         @id @default(uuid())
  employeeNo String         @unique
  fullName   String
  email      String         @unique
  department String
  position   String
  phone      String?
  joinDate   DateTime       @db.Date
  status     EmployeeStatus @default(ACTIVE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}
